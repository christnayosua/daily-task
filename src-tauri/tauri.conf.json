{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowTask",
  "version": "0.1.0",
  "identifier": "com.flowtask.app",
  "build": {
    "frontendDist": "../static",
    "devUrl": "http://localhost:8000/?v=2"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FlowTask",
        "width": 420,
        "height": 780,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
